<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/main_modules_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_bold"
            android:text="iOS 27 Replica"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/sf_pro_regular"
            android:text="Part 1: Lock Screen Engine"
            android:textColor="#99FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_grant_permissions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/sf_pro_semibold"
            android:text="1. Grant Wallpaper, Camera &amp; Overlay Access"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_notification_access"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/sf_pro_semibold"
            android:text="2. Enable Lock Screen Notifications Sync"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_start_lock_service"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/sf_pro_semibold"
            android:text="3. Start Power-Button Lock Screen Service"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_preview_lock_screen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:fontFamily="@font/sf_pro_semibold"
            android:text="Preview iOS Lock Screen Now"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
