<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/main_modules_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="iOS 27 Replica"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Enable these permissions once so the iOS UI runs seamlessly:"
            android:textColor="#99FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_grant_permissions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:text="1. Grant Overlay, Camera &amp; Wallpaper Access"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_accessibility_access"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:text="2. Enable Accessibility Service (iOS 27 Engine)"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_notification_access"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:text="3. Enable Lock Screen Notifications Sync"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_default_home"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:text="4. Set iOS 27 UI as Default Home App"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_start_lock_service"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:text="5. Start Lock Screen Background Service"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_preview_lock_screen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Preview iOS Lock Screen Now"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
