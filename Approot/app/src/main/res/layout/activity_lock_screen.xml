<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://android.com"
    android:id="@+id/lock_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Full-screen Lock Screen Wallpaper synced from System Settings -->
    <ImageView
        android:id="@+id/iv_lock_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Lock Screen Wallpaper" />

    <!-- Subtle top/bottom vignette so white text & glass pop on bright wallpapers -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#14000000" />

    <!-- Sliding Foreground Container (slides up smoothly on Home Bar swipe) -->
    <RelativeLayout
        android:id="@+id/lock_sliding_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Date + Tall Condensed Liquid Glass Clock -->
        <LinearLayout
            android:id="@+id/clock_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="64dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_lock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.01"
                android:shadowColor="#40000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="Wed Apr 1"
                android:textColor="#F2FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.replica.iosui.lockscreen.GlassClockView
                android:id="@+id/glass_clock_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp" />
        </LinearLayout>

        <!-- Bottom Action Zone: Flashlight (Left) & Camera (Right) -->
        <FrameLayout
            android:id="@+id/bottom_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="44dp"
            android:paddingStart="34dp"
            android:paddingEnd="34dp">

            <!-- Working iOS Flashlight Button -->
            <FrameLayout
                android:id="@+id/btn_flashlight"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_ios_glass_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_flashlight_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ios_flashlight"
                    android:contentDescription="Flashlight" />
            </FrameLayout>

            <!-- Working iOS Camera Button -->
            <FrameLayout
                android:id="@+id/btn_camera"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_ios_glass_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_camera_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ios_camera"
                    android:contentDescription="Camera" />
            </FrameLayout>
        </FrameLayout>

        <!-- Bottom-Up Stacked Notifications List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_lock_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottom_actions_container"
            android:layout_below="@id/clock_header_container"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <!-- Bottom Swipe-Up Touch Target + Crisp White iOS Home Bar -->
        <FrameLayout
            android:id="@+id/swipe_up_touch_zone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_alignParentBottom="true">

            <View
                android:id="@+id/ios_home_bar"
                android:layout_width="134dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="9dp"
                android:background="@drawable/bg_ios_home_bar" />
        </FrameLayout>

    </RelativeLayout>

</FrameLayout>
